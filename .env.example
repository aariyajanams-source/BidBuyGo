# Copy to .env and fill in. Never commit .env.

# Profile: leave empty for in-memory H2, or set to "postgres"
SPRING_PROFILES_ACTIVE=

# Postgres (only used with the postgres profile)
DB_URL=jdbc:postgresql://localhost:5432/bidbuygo
DB_USERNAME=bidbuygo
DB_PASSWORD=

# JWT: Base64-encoded key of at least 256 bits (e.g. `openssl rand -base64 32`)
JWT_SECRET=
JWT_EXPIRATION_MINUTES=60
